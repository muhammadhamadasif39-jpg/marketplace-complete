# Copy this file to .env and fill in your real values
# NEVER commit the real .env file to GitHub

# MongoDB Atlas connection string
# Get free one at https://www.mongodb.com/cloud/atlas
MONGO_URI=mongodb+srv://muhammadhamadhafiz07_db_user:Hamad114477X@cluster0.26iv4c6.mongodb.net/marketplace?appName=Cluster0

# JWT secret - use a long random string in production
# Generate one: run `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`
JWT_SECRET=replace_this_with_a_long_random_string

# Separate secret for refresh tokens (must be different from JWT_SECRET)
JWT_REFRESH_SECRET=replace_this_with_a_different_long_random_string

# Token lifetimes (optional - these are the defaults)
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Set to "true" once you want unverified users blocked from logging in
REQUIRE_EMAIL_VERIFICATION=false

# --- Email (SMTP) settings ---
# Leave blank during local development - emails will just be logged to the console instead.
# For Gmail: use smtp.gmail.com, port 587, and a Gmail "App Password" (not your normal password).
# For testing: Mailtrap.io gives you a free sandbox inbox with its own SMTP credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Marketplace <no-reply@yourdomain.com>"

# --- Payment Gateways ---
# JazzCash (get these from your JazzCash merchant dashboard)
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_ENV=sandbox

# Easypaisa (get these from your Easypaisa merchant dashboard)
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_ENV=sandbox

# Stripe (only needed if you set up a Stripe account for card payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Your backend's own public URL (needed so JazzCash/Easypaisa know where to call back)
SERVER_URL=http://localhost:5000

# --- SMS (Twilio, for OTP verification) ---
# Leave blank during local development - OTPs will just be logged to the console instead.
# Free trial available at https://www.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OTP_SENDER_NAME=MarketHub

# Server port
PORT=5000

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000
